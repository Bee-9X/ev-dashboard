# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=ClusterEV

# Port for the portal API, OCPP SOAP and OCPP-J WebSocket (expose this one through ngrok)
PORT=3003
# Extra WebSocket-only port for chargers still configured with ws://host:3002/... (0 = disabled)
LEGACY_WS_PORT=3002

# Portal API protection (Phase 0 stop-gap). If set, the frontend must send it as x-api-key
# (REACT_APP_API_KEY in plugev-portal/.env). Leave empty only on a trusted local machine.
API_KEY=
# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# OCPP behaviour
HEARTBEAT_INTERVAL_SEC=30
OFFLINE_AFTER_SEC=90
COMMAND_TIMEOUT_MS=30000
SOAP_COMMAND_TIMEOUT_MS=15000
# true = accept chargers that are not registered in the portal (discovery). false = reject them.
ALLOW_UNREGISTERED=true
# Optional comma separated idTag allow-list. Empty = accept every idTag.
ID_TAG_ALLOWLIST=

# Days to keep raw OCPP messages for diagnostics
MESSAGE_RETENTION_DAYS=30
# debug | info | warn | error  (debug prints raw XML / JSON frames)
LOG_LEVEL=info

# Link to the PLUG EV platform: charger activity shows live in the new admin portal.
# PLATFORM_GATEWAY_KEY must equal GATEWAY_API_KEY in plugev-api/.env. Leave empty to keep the link off.
PLATFORM_API_URL=http://localhost:4000/api/v1
PLATFORM_GATEWAY_KEY=
