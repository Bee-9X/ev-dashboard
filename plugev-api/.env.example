# Copy to .env (git-ignored). Never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Create the database first, e.g.:  CREATE DATABASE plugev;
DATABASE_URL=postgres://postgres:<password>@localhost:5432/plugev
DB_SSL=false
# Apply pending migrations on startup (set false if a release pipeline runs them)
DB_RUN_MIGRATIONS=true

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts MFA secrets stored in the database. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the secrets manager; changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=
# Name shown in authenticator apps
MFA_ISSUER=PLUG EV

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_HOURS=72
# Requests per minute per IP on login / refresh / password reset
AUTH_RATE_LIMIT_PER_MIN=10

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
# Portal base URL used in invitation and password reset links
PORTAL_URL=http://localhost:3000
# Start of the links in the connectors' QR codes (default: PORTAL_URL/c). The links are printed on stickers,
# so choose the production domain once and keep it: https://<your domain>/c
QR_LINK_BASE=

# Chargers (OCPP 1.5/1.6 SOAP and OCPP 1.6J) connect to this port, not to PORT. ngrok points here.
OCPP_ENABLED=true
OCPP_PORT=3003
# Heartbeat interval given to chargers at boot (seconds)
OCPP_HEARTBEAT_INTERVAL_SEC=30
# A charger without a message for this long is shown offline (seconds)
CHARGER_OFFLINE_AFTER_SEC=120
# Comma separated idTags allowed to charge; empty = every idTag (until EV user accounts exist)
OCPP_ID_TAG_ALLOWLIST=
# How long every OCPP message is kept for diagnosis (days)
OCPP_MESSAGE_RETENTION_DAYS=30
# Only for the old gateway (plugev-server): the key it sends with charger events (at least 32 characters).
# Not needed: chargers connect to the API itself.
GATEWAY_API_KEY=
# true when running behind a reverse proxy / tunnel so client IPs are read from X-Forwarded-For
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Email. "log" writes every email (links included) to the log instead of sending it: use it until an
# email provider is chosen. "smtp" sends through any SMTP service (Amazon SES, Azure Communication
# Services, SendGrid, Brevo, Microsoft 365, ...).
MAIL_TRANSPORT=log
MAIL_FROM=PLUG EV <no-reply@plugev.local>
SMTP_HOST=
# 587 with STARTTLS (SMTP_SECURE=false) or 465 with TLS from the start (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# Refuse to send unless the connection is encrypted (keep true outside local testing)
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
