# Copy to .env (git-ignored). Never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Create the database first, e.g.:  CREATE DATABASE plugev;
DATABASE_URL=postgres://postgres:<password>@localhost:5432/plugev
DB_SSL=false
# Apply pending migrations on startup (set false if a release pipeline runs them)
DB_RUN_MIGRATIONS=true

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts MFA secrets stored in the database. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the secrets manager; changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=
# Name shown in authenticator apps
MFA_ISSUER=PLUG EV

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MIN=30
INVITE_TTL_HOURS=72
# Requests per minute per IP on login / refresh / password reset
AUTH_RATE_LIMIT_PER_MIN=10

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000
# Portal base URL used in invitation and password reset links
PORTAL_URL=http://localhost:3000
# true when running behind a reverse proxy / tunnel so client IPs are read from X-Forwarded-For
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
