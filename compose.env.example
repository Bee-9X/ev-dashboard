# Settings for docker-compose.yml. Copy to .env in this folder (git-ignored) and fill in.
# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (passwords, JWT secret)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (MFA key)

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
MFA_ENCRYPTION_KEY=

# Addresses as the browser sees them
# Admin portal (also the base of the links in invitation / reset emails)
PORTAL_URL=http://localhost:8080
# Start of the links in the connectors' QR codes, e.g. https://<your domain>/c (default: PORTAL_URL/c).
# The links are printed on stickers: set the production domain once and keep it.
QR_LINK_BASE=
# Core API (without /api/v1)
API_PUBLIC_URL=http://localhost:4000
# Phase 0 portal with the charger test console, and the gateway it calls
CONSOLE_URL=http://localhost:8081
GATEWAY_PUBLIC_URL=http://localhost:3003
# Shared key between the charger gateway and the core API: charger activity then shows live in the admin
# portal. At least 32 characters; empty = link off.
PLATFORM_GATEWAY_KEY=
# Optional Phase 0 gateway API key (also baked into the Phase 0 portal build)
GATEWAY_API_KEY=

# Email: "log" until a provider is chosen (links appear in `docker compose logs api`)
MAIL_TRANSPORT=log
MAIL_FROM=PLUG EV <no-reply@plugev.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info
